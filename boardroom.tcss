Screen {
    background: $surface;
}

#main {
    height: 1fr;
    layout: horizontal;
}

#chat-column {
    width: 1fr;
    layout: vertical;
}

#chat {
    height: 1fr;
    padding: 1 2;
    background: $surface;
}

#current {
    height: auto;
    min-height: 3;
    max-height: 12;
    padding: 1 2;
    margin: 0 1 1 1;
    border: round $accent;
    background: $boost;
}

#sidebar {
    width: 34;
    layout: vertical;
    border-left: solid $primary;
    padding: 1 2;
    background: $surface;
}

.section-title {
    margin-bottom: 1;
    color: $text;
    text-style: bold;
}

.roster-row {
    height: 1;
    margin-bottom: 1;
}

#roster {
    height: auto;
    margin-bottom: 2;
}

#tally {
    height: auto;
    border: round $primary;
    padding: 1 2;
}

#token-usage {
    height: auto;
    border: round $boost;
    padding: 1 2;
    margin-top: 1;
}

SetupScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.6);
}

#setup-container {
    width: 60;
    height: auto;
    max-height: 16;
    padding: 2 4;
    background: $surface;
    border: thick $primary;
    layout: vertical;
}

#setup-title {
    height: 1;
    content-align: center middle;
    color: $text;
    margin-bottom: 1;
}

#setup-question {
    height: 1;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 1;
}

#setup-options {
    height: auto;
    align: center middle;
    margin-bottom: 1;
}

#setup-options Button {
    margin: 0 1;
    min-width: 14;
}

#setup-help {
    height: 1;
    content-align: center middle;
    color: $text-muted;
}

InterjectScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.6);
}

#interject-container {
    width: 70;
    height: auto;
    padding: 2 4;
    background: $surface;
    border: thick $primary;
    layout: vertical;
}

#interject-title {
    height: 1;
    content-align: center middle;
    color: $text;
    margin-bottom: 1;
}

#interject-help {
    height: auto;
    content-align: center middle;
    color: $text-muted;
    margin-bottom: 1;
}

#interject-input {
    margin-bottom: 1;
}

#interject-hint {
    height: 1;
    content-align: center middle;
    color: $text-muted;
}
