Screen {
    background: $surface;
    layout: vertical;
}

#sub-header {
    height: 1;
    content-align: center middle;
    color: $text-muted;
    margin: 1 0 0 0;
}

#stage {
    height: 1fr;
    align: center middle;
    padding: 1 2;
}

FocalCard {
    width: 80%;
    max-width: 110;
    min-height: 14;
    height: auto;
    padding: 2 4;
    border: round $primary;
    background: $surface;
    color: $text;
    content-align: left top;
}

#status-row {
    height: 3;
    padding: 0 2;
    background: $boost;
    border-top: solid $primary;
    layout: horizontal;
    align: center middle;
}

.status-dot {
    width: auto;
    margin: 0 2;
    content-align: center middle;
}

#status-tally {
    width: auto;
    margin-left: 4;
    content-align: center middle;
}

HistoryScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.6);
}

#history-container {
    width: 80%;
    max-width: 120;
    height: 80%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
    layout: vertical;
}

#history-title {
    height: 1;
    margin-bottom: 1;
}

#history-scroll {
    height: 1fr;
    border: solid $boost;
    padding: 1 2;
}

.history-turn {
    height: auto;
    padding: 1 2;
    margin-bottom: 1;
    border-left: thick $primary;
    background: $boost;
}

.history-empty {
    content-align: center middle;
    color: $text-muted;
    padding: 2 0;
}
